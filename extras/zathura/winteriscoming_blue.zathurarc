# Winter is Coming Dark Blue for zathura: include this file from ~/.config/zathura/zathurarc
# upstream: https://github.com/johnpapa/vscode-winteriscoming

set default-bg "#011627"
set default-fg "#bce7ff"
set statusbar-bg "#010e1a"
set statusbar-fg "#7799bb"
set inputbar-bg "#010e1a"
set inputbar-fg "#d6deeb"
set completion-bg "#010e1a"
set completion-fg "#d6deeb"
set completion-group-bg "#010e1a"
set completion-group-fg "#219fd5"
set completion-highlight-bg "#0b2942"
set completion-highlight-fg "#eeefff"
set notification-bg "#0b2942"
set notification-fg "#d6deeb"
set notification-error-bg "#ef5350"
set notification-error-fg "#000a11"
set notification-warning-bg "#ffca28"
set notification-warning-fg "#000a11"
set index-bg "#011627"
set index-fg "#bce7ff"
set index-active-bg "#0b2942"
set index-active-fg "#eeefff"
set scrollbar-bg "#010e1a"
set scrollbar-fg "#103362"
set render-loading-bg "#011627"
set render-loading-fg "#bce7ff"
set recolor-lightcolor "#011627"
set recolor-darkcolor "#bce7ff"
set highlight-color "rgba(247,236,181,0.4)"
set highlight-active-color "rgba(247,140,108,0.5)"
set visual-caret-color "rgba(33,159,213,0.7)"
set signature-success-color "rgba(141,236,149,0.9)"
set signature-warning-color "rgba(255,202,40,0.9)"
set signature-error-color "rgba(239,83,80,0.9)"
