# Winter is Coming Light for zathura: include this file from ~/.config/zathura/zathurarc
# upstream: https://github.com/johnpapa/vscode-winteriscoming

set default-bg "#ffffff"
set default-fg "#002339"
set statusbar-bg "#f3f3f3"
set statusbar-fg "#37567c"
set inputbar-bg "#f3f3f3"
set inputbar-fg "#3e3e3e"
set completion-bg "#f3f3f3"
set completion-fg "#3e3e3e"
set completion-group-bg "#f3f3f3"
set completion-group-fg "#2f86d2"
set completion-highlight-bg "#e3e3e3"
set completion-highlight-fg "#011627"
set notification-bg "#e3e3e3"
set notification-fg "#3e3e3e"
set notification-error-bg "#de3d3b"
set notification-error-fg "#ffffff"
set notification-warning-bg "#9a6a00"
set notification-warning-fg "#ffffff"
set index-bg "#ffffff"
set index-fg "#002339"
set index-active-bg "#e3e3e3"
set index-active-fg "#011627"
set scrollbar-bg "#f3f3f3"
set scrollbar-fg "#cee1f0"
set render-loading-bg "#ffffff"
set render-loading-fg "#002339"
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#002339"
set highlight-color "rgba(176,95,10,0.4)"
set highlight-active-color "rgba(218,82,33,0.5)"
set visual-caret-color "rgba(47,134,210,0.7)"
set signature-success-color "rgba(7,128,94,0.9)"
set signature-warning-color "rgba(154,106,0,0.9)"
set signature-error-color "rgba(222,61,59,0.9)"
