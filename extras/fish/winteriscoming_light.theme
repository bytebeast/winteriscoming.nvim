# name: 'Winter is Coming Light'
# url: 'https://github.com/johnpapa/vscode-winteriscoming'
# preferred_background: ffffff
# Copy to ~/.config/fish/themes/, then: fish_config theme choose winteriscoming_light

fish_color_normal 002339
fish_color_command b1108e
fish_color_builtin 08134a
fish_color_function b1108e
fish_color_keyword 0784a6
fish_color_param 6b6b6b
fish_color_option a85f08
fish_color_quote a44185
fish_color_escape b8418f
fish_color_redirection 7b30d0
fish_color_operator 7b30d0
fish_color_end da5221
fish_color_comment 357b42 --italics
fish_color_error de3d3b
fish_color_valid_path --underline
fish_color_autosuggestion 7a9eb8
